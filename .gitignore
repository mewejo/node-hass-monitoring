# Locally generated test broker material. Never commit these: this is a public
# repo, and committing private keys is a bad habit even when the key is a
# throwaway for a container that guards nothing.
tests/broker/certs/
tests/broker/passwd

# Runtime configuration holds the MQTT password. It is written on the monitored
# node at install time and must never reach the repo.
*.env
config.env

# Fake /sys trees, built by tests/fixtures/make-fixtures.sh. Generated rather
# than committed: they are ~130 tiny files that would swamp every diff, and they
# rely on symlinks that git does not round-trip faithfully everywhere. The
# generator is the source of truth and the test runner builds them on demand.
tests/fixtures/sysfs-*/
